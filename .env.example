# 실제 키는 .env 에만 두고 절대 커밋하지 않는다.

# ─────────────────────────────────────────────────────────────
# 공급자 전환
# OpenAI SDK 의 baseURL 만 바꾸면 OpenAI 호환 엔드포인트를 그대로 쓴다.
# 아래 중 하나를 골라 주석을 풀 것.
# ─────────────────────────────────────────────────────────────

# [A] OpenAI (유료 · 프롬프트 캐싱 측정 가능)
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-6-luna
# OPENAI_MODEL_HEAVY=gpt-6-sol
# OPENAI_MODEL_LEGACY=gpt-4.1-mini

# [B] Groq (무료 티어 · 매우 빠름 · 캐싱 지표 없음)
# 계정별로 가용 모델이 다르다. GET /openai/v1/models 로 확인할 것.
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-20b
OPENAI_MODEL_HEAVY=openai/gpt-oss-120b

# [C] Gemini (무료 티어 · OpenAI 호환 경로)
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-3.8-flash

# [D] Ollama (완전 로컬 · 키 불필요 · 토큰 단가 없음)
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.1:8b
# OPENAI_API_KEY=ollama

OPENAI_API_KEY=

# ─────────────────────────────────────────────────────────────
# 실험 손잡이
# ─────────────────────────────────────────────────────────────

# 대화 히스토리 전략: full | window | summary
HISTORY_STRATEGY=full
HISTORY_WINDOW=6

# 측정 레코드 파일명. runs/{RUN_LABEL}.jsonl
RUN_LABEL=dev

PORT=3000
API_BASE_URL=http://localhost:3000
